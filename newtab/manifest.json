{
  "manifest_version": 3,
  "name": "Nightglass New Tab",
  "version": "1.3.0",
  "description": "New tab page with a clock, daily focus, to-dos, links, weather and a quote over a star chart.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "search",
    "favicon",
    "geolocation"
  ]
}
